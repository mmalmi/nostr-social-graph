{
  "name": "nostr-social-graph",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "Nostr social graph library",
  "main": "dist/nostr-social-graph.cjs",
  "module": "dist/nostr-social-graph.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nostr-social-graph.es.js",
      "require": "./dist/nostr-social-graph.cjs"
    },
    "./data/socialGraph.bin": "./data/socialGraph.bin",
    "./data/profileData.json": "./data/profileData.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest",
    "build": "vite build && tsc",
    "prepare": "vite build && tsc",
    "crawl": "tsx ./scripts/crawler --once",
    "crawl-prod": "tsx ./scripts/productionCrawl --run",
    "index": "tsx ./scripts/profileIndexer --once",
    "publish-profile-index": "tsx ./scripts/publishProfileSearchIndex --run",
    "server": "tsx ./server/server",
    "examples": "cd examples && vite build && tsc",
    "examples-dev": "cd examples && vite && tsc",
    "e2e": "playwright test",
    "prepare-npm-release": "tsx ./scripts/reduceGraphSize.ts",
    "prepack": "pnpm run prepare-npm-release",
    "docs": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmalmi/nostr-social-graph.git"
  },
  "author": "Martti Malmi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mmalmi/nostr-social-graph/issues"
  },
  "homepage": "https://github.com/mmalmi/nostr-social-graph",
  "documentation": "https://mmalmi.github.io/nostr-social-graph/docs/",
  "files": [
    "src",
    "dist",
    "data/socialGraph.bin",
    "data/profileData.json"
  ],
  "devDependencies": {
    "@cashu/cashu-ts": "^4.7.1",
    "@hashtree/core": "https://github.com/mmalmi/hashtree/releases/download/hashtree-core-ts-v0.1.8/hashtree-core-0.1.8.tgz",
    "@hashtree/index": "https://github.com/mmalmi/hashtree/releases/download/hashtree-index-ts-v0.1.9/hashtree-index-0.1.9.tgz",
    "@playwright/test": "^1.61.1",
    "@scure/base": "^2.2.0",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.20.1",
    "@types/node-fetch": "^2.6.13",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^4.7.0",
    "applesauce-core": "^6.2.0",
    "applesauce-loaders": "^6.2.0",
    "applesauce-react": "^6.0.0",
    "applesauce-relay": "^6.2.1",
    "autoprefixer": "^10.5.4",
    "classnames": "^2.5.1",
    "daisyui": "^4.12.24",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "minidenticons": "^4.2.1",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "rxjs": "^7.8.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-lru-cache": "^2.0.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "websocket-polyfill": "^1.0.0",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/hashes": "^2.2.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "nostr-tools": "^2.23.12"
  }
}
